NODE_ENV=development
PORT=3000

# Production database. When set, the API uses PostgreSQL repositories.
DATABASE_URL=postgresql://user:password@localhost:5432/zeerocodes
DB_POOL_MAX=10

# Development-only identity bootstrap. Ignored when DATABASE_URL is set.
DEV_TENANT_ID=demo-tenant
DEV_USER_ID=demo-user
DEV_USER_EMAIL=demo@example.com
DEV_USER_ROLE=owner
