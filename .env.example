NODE_ENV=development
PORT=3000

# PostgreSQL. Production requires this.
DATABASE_URL=postgresql://user:password@localhost:5432/zeerocodes
DB_POOL_MAX=10

# Session boundary. Production requires a long random secret.
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_TTL_SECONDS=3600

# Development-only identity bootstrap. Ignored by production authentication.
DEV_TENANT_ID=demo-tenant
DEV_USER_ID=demo-user
DEV_USER_EMAIL=demo@example.com
DEV_USER_ROLE=owner
